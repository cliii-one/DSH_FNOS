#!/bin/bash

# DSH - 飞牛 fnOS 生命周期控制脚本
#
# 两种运行模式（安装向导可切换）：
#   网关模式（默认）：桥接器在 TRIM_APPDEST 下创建 dsh.sock，
#                     由飞牛统一网关鉴权后转发，不占用任何端口
#   端口模式（回退）  ：桥接器监听 0.0.0.0:PORT 并反代 dsh web，
#                     适合网关不可用或需要直连端口的场景
#
# Node 运行时来自应用中心依赖包 nodejs_v24（manifest 已声明）

APPNAME="${TRIM_APPNAME:-DSH}"

TRIM_APPDEST="${TRIM_APPDEST:-}"
TRIM_PKGVAR="${TRIM_PKGVAR:-}"

if [ -z "${TRIM_APPDEST}" ] || [ -z "${TRIM_PKGVAR}" ]; then
    echo "ERROR: TRIM_APPDEST or TRIM_PKGVAR not set" >&2
    exit 1
fi

# 网关模式开关：向导未配置时默认启用（官方推荐的安全方案）
GATEWAY_ENABLED="${wizard_enable_gateway:-true}"

# 端口模式参数（仅网关关闭时生效）
SERVICE_PORT="${wizard_port:-${TRIM_SERVICE_PORT:-3082}}"
INTERNAL_PORT=$((SERVICE_PORT + 1))
PORT_PATTERN=":(${SERVICE_PORT}|${INTERNAL_PORT}) "

# 系统依赖的 Node 运行时：飞牛应用中心 nodejs_v24 包
NODE_RUNTIME="/var/apps/nodejs_v24/target/bin/node"
if [ ! -x "${NODE_RUNTIME}" ]; then
    # 兜底：从 PATH 找 node（依赖包目录结构变化时不至于直接挂掉）
    NODE_RUNTIME="$(command -v node || true)"
fi

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true

LOG_FILE="${TRIM_PKGVAR}/${APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APPNAME}.pid"
SOCKET_FILE="${TRIM_APPDEST}/dsh.sock"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 日志轮转：超过 10MB 保留一份 .log.1，防止无限增长
rotate_log_if_needed() {
    [ -f "${LOG_FILE}" ] || return 0
    local size
    size=$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)
    if [ "${size}" -gt $((10 * 1024 * 1024)) ]; then
        mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
        log_msg "Log rotated (${size} bytes)"
    fi
}
rotate_log_if_needed

# 校验 PID 是否为本应用进程（runner.js / @deepseek-ai/dsh 特征）
# 防止把端口被其他应用占用时的进程误认为自己的实例
is_our_process() {
    local pid="$1"
    [ -z "${pid}" ] && return 1
    local cmdline
    cmdline=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)
    case "${cmdline}" in
        *runner.js*|*@deepseek-ai/dsh*) return 0 ;;
        *) return 1 ;;
    esac
}

# PID 文件丢失/失效时，按命令行特征找回存活实例（排除脚本自身）
runner_pids() {
    pgrep -f "${TRIM_APPDEST}/bin/runner.js" 2>/dev/null | grep -vx "$$" | head -n 1
}

instance_alive() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 端口模式：查端口占用者
port_owner_pid() {
    local owner
    owner=$(netstat -tlnp 2>/dev/null | grep -E "${PORT_PATTERN}" | sed -n 's/.*[[:space:]]\([0-9]\+\)\/[A-Za-z0-9_+.-]*[[:space:]]*$/\1/p' | sort -un | head -n 1)
    [ -n "${owner}" ] && echo "${owner}"
}

recover_running_instance() {
    local pid
    pid=$(runner_pids)
    if instance_alive "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}"
        log_msg "Recovered running instance PID ${pid} (PID file was missing/stale)"
        return 0
    fi
    return 1
}

# 启动前置检查：node 运行时与 DSH 本体
preflight_check() {
    if [ -z "${NODE_RUNTIME}" ] || [ ! -x "${NODE_RUNTIME}" ]; then
        log_msg "ERROR: node runtime not found (nodejs_v24)"
        echo "✗ 未找到 Node.js 运行时，请确认应用中心已安装 nodejs_v24" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
        return 1
    fi
    if [ ! -d "${TRIM_APPDEST}/node_modules/@deepseek-ai/dsh" ]; then
        log_msg "ERROR: DSH core missing"
        echo "✗ DSH 本体缺失，安装包不完整，请重新下载安装。" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
        return 1
    fi
    return 0
}

start_process() {
    log_msg "Starting ${APPNAME} (mode: gateway=${GATEWAY_ENABLED}, port=${SERVICE_PORT})..."

    # 已在运行则直接返回：优先读 PID 文件，失效时按特征兜底找回
    if [ -f "${PID_FILE}" ]; then
        local old_pid
        old_pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${old_pid}"; then
            log_msg "${APPNAME} already running with PID ${old_pid}"
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if recover_running_instance; then
        return 0
    fi

    preflight_check || return 1

    # 网关模式：sock 残留（上次异常退出留下的死 sock）直接重建
    if [ "${GATEWAY_ENABLED}" = "true" ] && [ -S "${SOCKET_FILE}" ]; then
        log_msg "Stale socket found, removing: ${SOCKET_FILE}"
        rm -f "${SOCKET_FILE}"
    fi

    # 端口模式：确认端口未被占用（区分本应用实例与其他应用）
    if [ "${GATEWAY_ENABLED}" != "true" ]; then
        local bound_pid
        bound_pid=$(port_owner_pid)
        if instance_alive "${bound_pid}"; then
            if is_our_process "${bound_pid}"; then
                log_msg "Port held by our instance PID ${bound_pid}, treating as running"
                printf "%s" "${bound_pid}" > "${PID_FILE}"
                return 0
            else
                log_msg "ERROR: port held by foreign process PID ${bound_pid}"
                echo "✗ 端口 ${SERVICE_PORT} 已被其他应用 (PID ${bound_pid}) 占用，请更换端口或启用统一网关" >&2
                return 1
            fi
        fi
    fi

    export PATH="$(dirname "${NODE_RUNTIME}"):${PATH}"
    # HOME 决定 DSH 的 .dsh 配置/凭据/插件 profile 位置。
    # 优先用数据共享目录（@appshare/dsh，飞牛文件管理可直接访问、SMB 可见），
    # 不可用时回退 var 目录
    DSH_HOME="${TRIM_DATA_SHARE_PATHS%%:*}"
    if [ -z "${DSH_HOME}" ] || [ ! -d "${DSH_HOME}" ]; then
        DSH_HOME="${TRIM_PKGVAR}"
    fi
    mkdir -p "${DSH_HOME}" 2>/dev/null || true
    export HOME="${DSH_HOME}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"

    cd "${TRIM_PKGVAR}" || return 1

    if [ "${GATEWAY_ENABLED}" = "true" ]; then
        # 网关模式：runner.js 启动 dsh web（仅 127.0.0.1）+ 在 TRIM_APPDEST 创建 dsh.sock
        export GATEWAY_SOCKET="dsh.sock"
        # 内部端口避开官方 deepseek-harness 的 3081
        export DSH_PORT="${DSH_PORT:-3083}"
        "${NODE_RUNTIME}" "${TRIM_APPDEST}/bin/runner.js" >> "${LOG_FILE}" 2>&1 &
    else
        # 端口模式：runner.js 额外监听 0.0.0.0:PORT 对局域网服务
        export PORT="${SERVICE_PORT}"
        export DSH_PORT="${INTERNAL_PORT}"
        export DSH_FALLBACK_PORT="1"
        "${NODE_RUNTIME}" "${TRIM_APPDEST}/bin/runner.js" >> "${LOG_FILE}" 2>&1 &
    fi
    local new_pid=$!
    printf "%s" "${new_pid}" > "${PID_FILE}"
    log_msg "Started with PID: ${new_pid}"

    # 探测 10 秒：若进程秒退则如实报错，避免误报启动成功
    local count=0
    while [ ${count} -lt 10 ]; do
        if ! kill -0 "${new_pid}" 2>/dev/null; then
            log_msg "Failed to start or process exited early (after ${count}s)"
            rm -f "${PID_FILE}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
    done
    return 0
}

stop_process() {
    log_msg "Stopping ${APPNAME}..."

    # 先向 PID 文件记录的进程发 TERM（runner.js 会联动回收 dsh 子进程）
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "Sending TERM to PID ${pid}"
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while kill -0 "${pid}" 2>/dev/null && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "Force killing PID ${pid}"
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
    fi

    # 清理残留的 runner / dsh 子进程；模式带路径限定，避免误杀无关进程
    local cleanup_pids
    cleanup_pids=$(pgrep -f "bin/runner\.js" 2>/dev/null; pgrep -f "@deepseek-ai/dsh.*bin\.js web" 2>/dev/null)
    for pid in $(echo "${cleanup_pids}" | sort -un); do
        [ -z "${pid}" ] && continue
        [ "${pid}" = "$$" ] && continue
        kill -9 "${pid}" 2>/dev/null || true
    done

    # 网关模式：确认 socket 已清理
    rm -f "${SOCKET_FILE}" 2>/dev/null || true

    # 端口模式：确认端口已释放，否则如实报告失败
    if [ "${GATEWAY_ENABLED}" != "true" ]; then
        sleep 1
        if ss -tln 2>/dev/null | grep -qE "${PORT_PATTERN}"; then
            log_msg "ERROR: port still bound after stop"
            rm -f "${PID_FILE}" 2>/dev/null || true
            return 1
        fi
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
    log_msg "Stopped successfully"
    return 0
}

status_process() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if recover_running_instance; then
        return 0
    fi
    return 3
}

case "$1" in
start)
    if start_process; then
        echo "✓ 启动成功"
        exit 0
    else
        echo "✗ 启动失败"
        exit 1
    fi
    ;;
stop)
    if stop_process; then
        echo "✓ 已停止"
        exit 0
    else
        echo "✗ 停止失败：端口 ${SERVICE_PORT} 仍被占用，请查看日志 ${LOG_FILE}"
        exit 1
    fi
    ;;
uninstall)
    stop_process
    echo "✓ 已清理"
    exit 0
    ;;
status)
    if status_process; then
        echo "✓ 服务运行中"
        exit 0
    else
        echo "✗ 服务未运行"
        exit 3
    fi
    ;;
restart)
    stop_process
    sleep 1
    if start_process; then
        echo "✓ 重启成功"
        exit 0
    else
        echo "✗ 重启失败"
        exit 1
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|status|restart|uninstall}"
    exit 1
    ;;
esac
