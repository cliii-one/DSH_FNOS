#!/bin/bash

# DSH - 飞牛 fnOS 生命周期控制脚本
#
# 接入方式：端口模式。runner.js 监听 0.0.0.0:${SERVICE_PORT}，
# 飞牛桌面入口（ui/config，type=iframe，port=3082）直接访问该端口。
#
# 运行依赖：应用中心 nodejs_v24 依赖包提供的 Node 运行时（manifest 已声明）

APPNAME="${TRIM_APPNAME:-dsh}"

TRIM_APPDEST="${TRIM_APPDEST:-}"
TRIM_PKGVAR="${TRIM_PKGVAR:-}"

if [ -z "${TRIM_APPDEST}" ] || [ -z "${TRIM_PKGVAR}" ]; then
    echo "ERROR: TRIM_APPDEST or TRIM_PKGVAR not set" >&2
    exit 1
fi

# 对外服务端口：由系统按 manifest 的 service_port 注入，
# 同时与 ui/config 中桌面入口的 port 保持一致（两处必须相同）
SERVICE_PORT="${TRIM_SERVICE_PORT:-3082}"
# 内部端口：dsh web 只监听回环，由 runner 代理
INTERNAL_PORT=$((SERVICE_PORT + 1))
PORT_PATTERN=":(${SERVICE_PORT}|${INTERNAL_PORT}) "

# 系统依赖的 Node 运行时（应用中心 nodejs_v24 包）
NODE_RUNTIME="/var/apps/nodejs_v24/target/bin/node"

# 数据目录：优先共享目录（飞牛文件管理可见、SMB 可访问），回退 var 目录
DSH_DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "${DSH_DATA_DIR}" ] || [ ! -d "${DSH_DATA_DIR}" ]; then
    DSH_DATA_DIR="${TRIM_PKGVAR}"
fi
mkdir -p "${DSH_DATA_DIR}" 2>/dev/null || true

LOG_FILE="${TRIM_PKGVAR}/${APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APPNAME}.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 日志轮转：超过 10MB 保留一份 .log.1，避免日志无限增长
rotate_log_if_needed() {
    [ -f "${LOG_FILE}" ] || return 0
    local size
    size=$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)
    if [ "${size}" -gt $((10 * 1024 * 1024)) ]; then
        mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
        log_msg "日志已轮转（${size} 字节）"
    fi
}
rotate_log_if_needed

instance_alive() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 按命令行特征找回存活实例（PID 文件丢失或失效时的兜底），排除脚本自身
runner_pid() {
    pgrep -f "${TRIM_APPDEST}/bin/runner.js" 2>/dev/null | grep -vx "$$" | head -n 1
}

recover_running_instance() {
    local pid
    pid=$(runner_pid)
    if instance_alive "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}"
        log_msg "已找回运行中的实例 PID ${pid}"
        return 0
    fi
    return 1
}

# 启动前检查：Node 运行时与 DSH 本体是否就绪
preflight_check() {
    if [ ! -x "${NODE_RUNTIME}" ]; then
        log_msg "ERROR: 未找到 Node 运行时 ${NODE_RUNTIME}"
        echo "✗ 未找到 Node.js 运行时，请确认应用中心已安装 nodejs_v24" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
        return 1
    fi
    if [ ! -f "${TRIM_APPDEST}/node_modules/@deepseek-ai/dsh/lib/bin.js" ]; then
        log_msg "ERROR: DSH 本体缺失"
        echo "✗ DSH 本体缺失，安装包不完整，请重新下载安装。" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
        return 1
    fi
    return 0
}

start_process() {
    log_msg "正在启动 ${APPNAME}（端口 ${SERVICE_PORT}）..."

    # 已在运行则直接返回
    if [ -f "${PID_FILE}" ]; then
        local old_pid
        old_pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${old_pid}"; then
            log_msg "${APPNAME} 已在运行，PID ${old_pid}"
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if recover_running_instance; then
        return 0
    fi

    preflight_check || return 1

    # 对外端口被占用则明确报错（提示用户更换端口）
    if netstat -tln 2>/dev/null | grep -qE "${PORT_PATTERN}"; then
        log_msg "ERROR: 端口 ${SERVICE_PORT}/${INTERNAL_PORT} 已被占用"
        echo "✗ 端口 ${SERVICE_PORT} 已被占用，请在应用设置中更换端口" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
        return 1
    fi

    export PATH="$(dirname "${NODE_RUNTIME}"):${PATH}"
    export HOME="${DSH_DATA_DIR}"
    # 必须显式设置 DSH_HOME：dsh 的 home 解析优先级为
    #   显式配置 > $DSH_HOME > os.homedir()/.dsh
    # 而 os.homedir() 取 passwd 中的家目录（/home/dsh），不认 $HOME。
    # 不设置会使 dsh 把配置与凭据写到 /home/dsh/.dsh，
    # 导致 runner 预置的认证密钥不被读取、前端认证失败。
    # 注意：DSH_HOME 指向 .dsh 目录本身。
    export DSH_HOME="${DSH_DATA_DIR}/.dsh"
    # 默认工作区目录：dsh 首次使用时会用 `xdg-user-dir DOCUMENTS` 定位系统文档
    # 目录，并在其下创建 deepseek-harness/default-workspace。
    # fnOS 未配置 XDG_DOCUMENTS_DIR，该命令会回退返回 $HOME，而 dsh 判定
    # 「文档目录等于 HOME」即视为不可用并报错（前端提示"无法创建默认工作区"）。
    # 显式指定文档目录到共享目录下，使工作区落在飞牛文件管理可见的位置。
    mkdir -p "${DSH_DATA_DIR}/Documents" 2>/dev/null || true
    export XDG_DOCUMENTS_DIR="${DSH_DATA_DIR}/Documents"
    # 交互终端使用的 shell：dsh 解析顺序为 $SHELL → passwd 中的登录 shell。
    # 飞牛为应用创建的用户登录 shell 是 /usr/sbin/nologin（所有应用用户皆如此），
    # 不指定会让侧边栏终端直接退出并提示 "This account is currently not available."。
    export SHELL="/bin/bash"
    export PORT="${SERVICE_PORT}"
    export DSH_PORT="${INTERNAL_PORT}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"

    # 以数据目录为工作目录启动运行器
    cd "${DSH_DATA_DIR}" || return 1

    "${NODE_RUNTIME}" "${TRIM_APPDEST}/bin/runner.js" >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    printf "%s" "${new_pid}" > "${PID_FILE}"
    log_msg "已启动，PID ${new_pid}"

    # 探测 10 秒：若进程秒退则如实报错，避免误报启动成功
    local count=0
    while [ ${count} -lt 10 ]; do
        if ! kill -0 "${new_pid}" 2>/dev/null; then
            log_msg "启动失败：进程在 ${count} 秒内退出"
            rm -f "${PID_FILE}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
    done
    return 0
}

stop_process() {
    log_msg "正在停止 ${APPNAME}..."

    # 先发 TERM 让 runner 优雅回收 dsh 子进程
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while kill -0 "${pid}" 2>/dev/null && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "强制结束 PID ${pid}"
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
    fi

    # 清理残留的 runner / dsh 进程（路径限定，避免误杀无关进程）
    local cleanup_pids
    cleanup_pids=$(
        pgrep -f "${TRIM_APPDEST}/bin/runner\.js" 2>/dev/null
        pgrep -f "${TRIM_APPDEST}/node_modules/@deepseek-ai/dsh.*bin\.js web" 2>/dev/null
    )
    for pid in $(echo "${cleanup_pids}" | sort -un); do
        [ -z "${pid}" ] && continue
        [ "${pid}" = "$$" ] && continue
        kill -9 "${pid}" 2>/dev/null || true
    done

    # 确认端口已释放，否则如实报告失败
    sleep 1
    if ss -tln 2>/dev/null | grep -qE "${PORT_PATTERN}"; then
        log_msg "ERROR: 停止后端口仍被占用"
        rm -f "${PID_FILE}" 2>/dev/null || true
        return 1
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
    log_msg "已停止"
    return 0
}

status_process() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if recover_running_instance; then
        return 0
    fi
    return 3
}

case "$1" in
start)
    if start_process; then
        echo "✓ 启动成功"
        exit 0
    else
        echo "✗ 启动失败"
        exit 1
    fi
    ;;
stop)
    if stop_process; then
        echo "✓ 已停止"
        exit 0
    else
        echo "✗ 停止失败：端口 ${SERVICE_PORT} 仍被占用，请查看日志 ${LOG_FILE}"
        exit 1
    fi
    ;;
uninstall)
    stop_process
    echo "✓ 已清理"
    exit 0
    ;;
status)
    if status_process; then
        echo "✓ 服务运行中"
        exit 0
    else
        echo "✗ 服务未运行"
        exit 3
    fi
    ;;
restart)
    stop_process
    sleep 1
    if start_process; then
        echo "✓ 重启成功"
        exit 0
    else
        echo "✗ 重启失败"
        exit 1
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|status|restart|uninstall}"
    exit 1
    ;;
esac
